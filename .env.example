# Resend — onboarding + quote email delivery
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile — form anti-bot
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Vercel Blob — image uploads (onboarding form)
BLOB_READ_WRITE_TOKEN=

# Twilio — SMS / account API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Stripe — Checkout + webhooks
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ONBOARDING=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# Base URL used in Stripe Checkout success/cancel redirects.
# Local: http://localhost:3000  ·  Production: https://juneaudigitaldesigns.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel KV (Upstash Redis) — stores signed MSA agreement records
# Provision via Vercel Dashboard → Storage → Create → Upstash Redis
# After provisioning, run `vercel env pull .env.local` to populate locally
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Client portal (/portal) ────────────────────────────────────────────────
# Clerk — auth for the client portal. Protects /portal and /api/portal/*.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/portal/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/portal
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/portal
# Clerk webhook signing secret — used by /api/webhooks/clerk to link a new
# self-serve sign-up to their paid onboarding record (subscribe to user.created).
CLERK_WEBHOOK_SIGNING_SECRET=

# Vercel — REQUIRED for the Traffic tab and the Overview health strip.
#
# Traffic reads Vercel Web Analytics; the health strip reads deployments and domains. Both
# are dead without these: the Traffic tab returns "We couldn't load this" on a perfectly
# healthy client, and Deploy/Domain sit on "Not checked". This is a real outage that already
# happened, so treat them as required rather than optional.
#
# Create at Vercel → Settings → Tokens, scoped to the JDD team. Note that Vercel has no
# read-only tokens — project-scoped ones deny team-level resources and cover a single
# project, which cannot work for a portal that queries every client's project. Keep this
# server-side only (never NEXT_PUBLIC_) and separate from the jdd-ops token so it can be
# rotated on its own.
#
# Web Analytics must also be switched on per client project in the Vercel dashboard; it has
# no API setter. Verify with `npm run audit-analytics` in jdd-ops.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Google PageSpeed Insights — Performance tab (score + CrUX real-user field data).
# Deliberately still Google: Vercel Speed Insights costs $10/project/month and has no public
# read API, so it cannot feed the portal. See RUNBOOK for the full comparison.
PAGESPEED_API_KEY=

# Airtable — Calls tab reads each client's "Call Log" base (same JDD token as jdd-ops).
AIRTABLE_API_KEY=

# Upstash Redis for the portal (cache + rate limit) — app/lib/portal-kv.ts uses
# Redis.fromEnv(), which reads these names (NOT the KV_REST_API_* above used by the MSA store).
# The Vercel Upstash integration can expose both; set these explicitly if it doesn't.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for /api/ops/* — machine-to-machine calls from the ops console.
#
# The console can change a client's plan in KV but never calls Stripe: it has no auth of any
# kind and runs on a restricted read-only key on purpose. It posts here instead, so the
# write-capable Stripe key stays in this deployed app. Set the same value in jdd-ops/.env.
#
# Unset means /api/ops/plan-sync answers 503 and does nothing — failing closed is the point.
# Use a long random value; it is the only thing in front of a route that can re-price a
# subscription.
OPS_SHARED_SECRET=
